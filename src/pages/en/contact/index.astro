---
import Slogan from '@/components/sections/Slogan.astro';
import Title1 from '@/components/sections/Title1.astro';
import Layout from '@/layouts/Layout.astro';

const title = 'Contact Us';
const description = 'Contact College of Religious Studies, Mahidol University';
---

<Layout title={title} description={description}>
	<Slogan title={title} description={description} bgImage="/img/contact-bg.png" />
	

	<div class="my-10 space-y-4 text-center">	

		<div class="text-lg font-semibold">College of Religious Studies
Mahidol University</div>
		<div>999 Salaya, PhutthamonthonNakhon Pathom 73170Thailand</div>
		<div>
			Tel. <a href="tel:+6628002630" class="text-blue-600 hover:underline">(02) 800-2630-9</a>
		</div>
		<div>
			Fax. <a href="fax:+6628002659" class="text-blue-600 hover:underline">(02) 800-2659</a>
		</div>
		<div>
			E-mail: <a href="mailto:crs@mahidol.ac.th" class="text-blue-600 hover:underline"
				>crs@mahidol.ac.th</a
			>
		</div>
	</div>

	<div class="mx-auto my-10 aspect-video h-96 max-w-full">
	<iframe
		src="https://www.google.com/maps?q=College+of+Religious+Studies,+Mahidol+University&hl=en&z=15&output=embed"
		width="100%"
		height="100%"
		style="border:0;"
		allowfullscreen=""
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
		class="mt-4">
	</iframe>
</div>
</Layout>
