---
import YoutubeVideo from '@/components/plugins/YoutubeVideo.astro';
import Banner from '@/components/sections/Banner.astro';
import Features from '@/components/sections/Features.astro';
import Hero from '@/components/sections/Hero.astro';
import Logos from '@/components/sections/Logos.astro';
import Slogan from '@/components/sections/Slogan.astro';
import Title1 from '@/components/sections/Title1.astro';
import Title2 from '@/components/sections/Title2.astro';
import Layout from '@/layouts/Layout.astro';
import FacebookPage from '@/components/plugins/FacebookPage.astro';
import Information from '@/components/sections/Information.astro';
import Congratulation from '@/components/sections/Congratulation.astro';
import Activities from '@/components/sections/Activities.astro';
import Seminar from '@/components/sections/Seminar.astro';
import Popup from '@/components/sections/Popup.astro';
import { homeContent } from '@/i18n/home';
const lang = 'en';

const t = {
  meta: {
    title: 'College of Religious Studies – Mahidol University',
    description: 'College of Religious Studies, Mahidol University',
  },
  collegeName: 'College of Religious Studies, Mahidol University',
  cardsTop: {
    history: 'History',
    vision: 'Mission & Vision',
    foundation: 'Namthong Foundation & Dormitory',
  },
  cardsBottom: {
    courses: 'Programs',
    news: 'CRS News',
    seminar: 'Seminars & Academic Lectures',
    students: 'CRS Students',
    activities: 'Activities',
    birth: 'Monthly Merit-Making',
  },
};
---


<Layout
  title={t.meta.title}
  description={t.meta.description}
  bodyclass="bg-white dark:bg-th-bg-2-dark"
>
  <Banner />
  <Popup />
  <Information />
  <Congratulation />
  <Activities />
  <Seminar />

  <!--ส่วนนี้ “ไม่จำเป็นต้องแปลทั้งหมด” 
  <Information />
  <Congratulation />
  <Activities /> 
  <Seminar />
-->
  <Title2 title={t.collegeName} description="" />

  <!-- Top Quick Links -->
  <section class="-mt-12 pb-12">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-10">

      <a href="/en/about/history" class="card">
        <img src="/img/mucrshistory.png" />
        <h4>{t.cardsTop.history}</h4>
      </a>

      <a href="/en/about/vision" class="card">
        <img src="/img/mucrs_mv.png" width="180" height="180" />
        <h4>{t.cardsTop.vision}</h4>
      </a>

      <a href="https://www.facebook.com/CRSNamthong" target="_blank" class="card">
        <img src="/img/ntdorm.jpg" width="180" height="180"/>
        <h4>{t.cardsTop.foundation}</h4>
      </a>

    </div>
  </section>

  <!-- Bottom Quick Links -->
  <section class="pb-16">
    <div class="max-w-7xl mx-auto px-4
                grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3
                gap-8">

      <a href="/en/education/syllabus" class="card group">
        <img src="/img/mucrs_courses.png" width="220" height="220" />
        <h4>{t.cardsBottom.courses}</h4>
      </a>
      
      <!--
      <a href="/en/news" class="card group">
        <img src="/img/mucrs_news.png" width="220" height="220" />
        <h4>{t.cardsBottom.news}</h4>
      </a>
      
      <a href="/en/seminar" class="card group">
        <img src="/img/seminar/25jul2025/25jul2025-1.jpg" />
        <h4>{t.cardsBottom.seminar}</h4>
      </a>

      <a href="/en/students" class="card group">
        <img src="/img/students/oct2025/10oct2025/10oct2025-4.jpg"/>
        <h4>{t.cardsBottom.students}</h4>
      </a>

      <a href="/en/activities" class="card group">
        <img src="/img/activities/sep2025/24sep2025-1.jpg" />
        <h4>{t.cardsBottom.activities}</h4>
      </a>

      <a href="/en/birth" class="card group">
        <img src="/img/birth/nov2025/28nov2025birth-1.jpg" />
        <h4>{t.cardsBottom.birth}</h4>
      </a>
    -->
    </div>
  </section>

</Layout>

<style>
.card {
  @apply bg-white rounded-[2rem]
         p-6 sm:p-8 md:p-10
         text-center border
         min-h-[220px]
         flex flex-col items-center justify-center
         transition-all duration-300
         hover:-translate-y-2
         hover:shadow-[0_18px_36px_rgba(0,0,0,0.12)];
}

.card h4 {
  @apply text-xs sm:text-sm
         font-normal text-black
         tracking-wider text-center;
}
</style>
