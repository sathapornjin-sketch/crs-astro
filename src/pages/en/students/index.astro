---
import Slogan from '@/components/sections/Slogan.astro';
import Layout from '@/layouts/Layout.astro';

const title = 'Current Students';
const description = 'Information for current students';
---

<Layout title={title} description={description}>
	<Slogan title={title} description={description} bgImage="/img/student-bg.png" />

	<div class="mx-auto mb-8 text-center">
		<p class="text-2xl font-semibold">MUCRS</p>
	</div>
	<div class="mx-auto mb-10 max-w-xl space-y-5 text-center text-2xl">
		<a
			class="link-hover card link flex h-20 items-center justify-center rounded-box bg-base-300"
			href="https://sites.google.com/view/crseportal"
			target="_blank"
		>
			CRS Student Portal
		</a>
		<a
			class="link-hover card link flex h-20 items-center justify-center rounded-box bg-base-300"
			href="https://www.facebook.com/share/15ySccGBMW/"
			target="_blank"
		>
			Student Association, College of Religious Studies, Mahidol University
		</a>
		<a
			class="link-hover card link flex h-20 items-center justify-center rounded-box bg-base-300"
			href="https://www.facebook.com/CRSNamthong"
			target="_blank"
		>
			Dormitory Namthong
		</a>
		<a
			class="link-hover card link flex h-20 items-center justify-center rounded-box bg-base-300"
			href="https://op.mahidol.ac.th/sa/scholarsupport/"
			target="_blank"
		>
			Scholarship
		</a>
		<a
			class="link-hover card link flex h-20 items-center justify-center rounded-box bg-base-300"
			href="https://lin.ee/ppoUAvS"
			target="_blank"
		>
			Contact Staff
		</a>
	</div>

	<div class="mx-auto mb-8 mt-12 text-center">
		<p class="text-2xl font-semibold">MU</p>
	</div>
	<div class="mx-auto mb-10 max-w-xl space-y-5 text-center text-2xl">
		<a
			class="link-hover card link flex h-20 items-center justify-center rounded-box bg-base-300"
			href="https://mustudent.mahidol.ac.th/"
			target="_blank"
		>
			MU Life Pass
		</a>
	</div>
</Layout>
