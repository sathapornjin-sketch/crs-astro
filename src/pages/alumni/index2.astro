---
import Layout from '@/layouts/Layout.astro';
import Slogan from '@/components/sections/Slogan.astro';

const title = 'ศิษย์เก่า';
const description = 'วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล';
---

<Layout title={title} description={description}>
<Slogan title={title} description={description} />

<!-- HERO -->
<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="season">Merry Christmas & Happy New Year</p>
    <h2>ศิษย์เก่าวิทยาลัยศาสนศึกษา</h2>
    <p class="subtitle">
      Alumni Community · College of Religious Studies, Mahidol University
    </p>
  </div>
</section>

<!-- NAVIGATION -->
<section class="nav-section">
  <div class="nav-grid">

    <a href="#news" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <rect x="4" y="3" width="16" height="18" rx="2"/>
          <line x1="7" y1="7" x2="17" y2="7"/>
          <line x1="7" y1="11" x2="17" y2="11"/>
          <line x1="7" y1="15" x2="13" y2="15"/>
        </svg>
      </div>
      <h3>ข่าวสารศิษย์เก่า</h3>
      <p>Updates & Communications</p>
    </a>

    <a href="#activities" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="7" r="3"/>
          <path d="M5 21c0-4 14-4 14 0"/>
        </svg>
      </div>
      <h3>กิจกรรมและการมีส่วนร่วม</h3>
      <p>Engagement & Forum</p>
    </a>

    <a href="#privileges" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <path d="M12 3l8 4v6c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V7z"/>
        </svg>
      </div>
      <h3>สิทธิประโยชน์</h3>
      <p>Privileges & Resources</p>
    </a>

    <a href="#network" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <circle cx="6" cy="12" r="2"/>
          <circle cx="18" cy="6" r="2"/>
          <circle cx="18" cy="18" r="2"/>
          <line x1="8" y1="12" x2="16" y2="6"/>
          <line x1="8" y1="12" x2="16" y2="18"/>
        </svg>
      </div>
      <h3>เครือข่ายศิษย์เก่า</h3>
      <p>Alumni Network</p>
    </a>

  </div>
</section>

<!-- CONTENT -->
<section id="news" class="content split">
  <div>
    <h2>ข่าวสารศิษย์เก่า</h2>
    <p>สะท้อนบทบาท ความเคลื่อนไหว และผลงานศิษย์เก่าที่สร้างคุณค่าแก่สังคม</p>
  </div>
  <img src="https://images.unsplash.com/photo-1529070538774-1843cb3265df" />
</section>

<section id="activities" class="content split reverse">
  <img src="https://images.unsplash.com/photo-1515187029135-18ee286d815b" />
  <div>
    <h2>กิจกรรมและความร่วมมือ</h2>
    <p>เวทีการแลกเปลี่ยนองค์ความรู้และการสร้างเครือข่ายระดับสากล</p>
  </div>
</section>

</Layout>

<style>
:root{
  --gold:#8b6b2e;
  --dark:#1b1b1b;
  --light:#f6f5f2;
}

/* HERO */
.hero{
  height:560px;
  background:url("https://images.unsplash.com/photo-1523580846011-d3a5bc25702b") center/cover;
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
}
.hero-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(135deg,rgba(0,0,0,.75),rgba(0,0,0,.35));
}
.hero-content{
  position:relative;
  text-align:center;
  color:#fff;
  max-width:820px;
}
.season{
  letter-spacing:.18em;
  font-size:.85rem;
  text-transform:uppercase;
  opacity:.85;
  margin-bottom:16px;
}
.hero-content h2{
  font-size:3.2rem;
}
.subtitle{
  margin-top:16px;
  opacity:.85;
}

/* NAV */
.nav-section{margin-top:-120px;}
.nav-grid{
  max-width:1100px;
  margin:0 auto 160px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:36px;
}
.nav-item{
  background:#fff;
  padding:48px 36px;
  border-radius:28px;
  text-align:center;
  text-decoration:none;
  color:var(--dark);
  box-shadow:0 32px 72px rgba(0,0,0,.14);
  transition:.4s ease;
}
.nav-item:hover{
  transform:translateY(-10px);
  box-shadow:0 42px 90px rgba(139,107,46,.35);
}

/* ICON */
.icon-wrap{
  width:84px;
  height:84px;
  margin:0 auto 20px;
  border-radius:50%;
  background:radial-gradient(circle,var(--gold),#fff 75%);
  display:flex;
  align-items:center;
  justify-content:center;
}
.icon-wrap svg{
  width:38px;
  height:38px;
  stroke:#111;
  stroke-width:1.8;
  fill:none;
}

/* CONTENT */
.content{
  max-width:1100px;
  margin:160px auto;
}
.split{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:72px;
  align-items:center;
}
.split.reverse{direction:ltr;}
.split img{
  width:100%;
  border-radius:32px;
}
</style>
