---
import Layout from '@/layouts/Layout.astro';
//import Slogan from '@/components/sections/Slogan.astro';

const title = 'ศิษย์เก่า';
const description = 'วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล';
---

<Layout title={title} description={description}>
<!--<Slogan title={title} description={description} />-->

<!-- HERO -->
<section class="hero" data-animate>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="season">Alumni Relations</p>
    <h2>ศิษย์เก่าวิทยาลัยศาสนศึกษา</h2>
    <p class="subtitle">
      College of Religious Studies, Mahidol University
    </p>
  </div>
</section>

<!-- NAVIGATION -->
<section class="nav-section" data-animate>
  <div class="nav-grid">

    <a href="#news" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <rect x="4" y="3" width="16" height="18" rx="2"/>
        </svg>
      </div>
      <h3>ข่าวสารศิษย์เก่า</h3>
      <p>Alumni News & Updates</p>
    </a>

    <a href="#activities" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3"/>
          <path d="M4 20c0-4 16-4 16 0"/>
        </svg>
      </div>
      <h3>กิจกรรม</h3>
      <p>Events & Engagement</p>
    </a>

    <a href="#privileges" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <path d="M12 3l8 4v6c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V7z"/>
        </svg>
      </div>
      <h3>สิทธิประโยชน์</h3>
      <p>Benefits & Services</p>
    </a>

    <a href="#network" class="nav-item">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24">
          <circle cx="6" cy="12" r="2"/>
          <circle cx="18" cy="6" r="2"/>
          <circle cx="18" cy="18" r="2"/>
        </svg>
      </div>
      <h3>เครือข่ายศิษย์เก่า</h3>
      <p>Alumni Network</p>
    </a>

  </div>
</section>

<!-- NEWS -->
<section id="news" class="content split" data-animate>
  <div>
    <h2>ข่าวสารศิษย์เก่า</h2>
    <p>
      ข่าว ความเคลื่อนไหว และบทบาทของศิษย์เก่าที่มีต่อสังคมและมหาวิทยาลัย
    </p>
  </div>
  <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655" />
</section>

<!-- ACTIVITIES -->
<section id="activities" class="content split reverse" data-animate>
  <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4" />
  <div>
    <h2>กิจกรรมและความร่วมมือ</h2>
    <p>
      เสริมสร้างความสัมพันธ์ระหว่างศิษย์เก่า นักศึกษา และเครือข่ายวิชาการ
    </p>
  </div>
</section>

<!-- STORIES -->
<section id="stories" class="content" data-animate>
  <h2 class="section-title">ศิษย์เก่าดีเด่น</h2>
  <div class="card-grid">
    <div class="story-card">
      <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91" />
      <h3>ดร. ตัวอย่าง นามสมมติ</h3>
      <p class="meta">รุ่นที่ 12 · นักวิชาการ</p>
      <p>สร้างคุณค่าเชิงวิชาการด้านศาสนาและสันติภาพ</p>
    </div>

    <div class="story-card">
      <img src="https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e" />
      <h3>อาจารย์ ตัวอย่าง</h3>
      <p class="meta">รุ่นที่ 9 · องค์กรระหว่างประเทศ</p>
      <p>ทำงานด้านศาสนาและสังคมในระดับนานาชาติ</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta" data-animate>
  <h2>ระบบทะเบียนศิษย์เก่า</h2>
  <p>ลงทะเบียนเพื่อรับข่าวสารและสิทธิประโยชน์จากมหาวิทยาลัย</p>
  <a href="/alumni/register" class="cta-btn">ลงทะเบียน / ปรับปรุงข้อมูล</a>
</section>

<!-- PDPA -->
<section class="pdpa">
  <p>
    การจัดเก็บข้อมูลเป็นไปตาม
    <a href="/privacy-policy">นโยบายคุ้มครองข้อมูลส่วนบุคคล</a>
  </p>
</section>

<script>
const items = document.querySelectorAll('[data-animate]');
const observer = new IntersectionObserver(entries=>{
  entries.forEach((e,i)=>{
    if(e.isIntersecting){
      e.target.classList.add('in');
      e.target.style.transitionDelay = `${i*80}ms`;
      observer.unobserve(e.target);
    }
  });
},{threshold:.12});
items.forEach(i=>observer.observe(i));
</script>

<style>
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ศิษย์เก่า - วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล</title>
  <style>
    /* ===============================
       GLOBAL / PREMIUM MOTION SYSTEM
    ================================= */
    :root{
      --gold:#8b6b2e;
      --navy:#002b5c;
      --dark:#1f1f1f;
      --gray:#666;
      --ease:cubic-bezier(.22,1,.36,1);
    }

    [data-animate]{
      opacity:0;
      transform:translateY(28px);
      transition:1s var(--ease);
    }
    [data-animate].in{
      opacity:1;
      transform:none;
    }

    /* HERO */
    .hero{
      height:360px;
      background:url("https://images.unsplash.com/photo-1523050854058-8df90110c9f1") center/cover;
      position:relative;
      display:flex;
      align-items:center;
      border-bottom:3px solid var(--gold);
    }
    .hero-overlay{
      position:absolute;
      inset:0;
      background:linear-gradient(to bottom,rgba(0,0,0,.65),rgba(0,0,0,.45));
    }
    .hero-content{
      position:relative;
      max-width:1100px;
      margin:auto;
      padding:0 24px;
      color:#fff;
    }

    /* NAV – STAGGER */
    .nav-section{background:#f4f6f9}
    .nav-grid{
      max-width:1100px;
      margin:-90px auto 120px;
      padding:0 24px;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:28px;
    }
    .nav-item{
      background:#fff;
      padding:32px 28px;
      border-radius:18px;
      border:1px solid #eee;
      text-decoration:none;
      color:var(--dark);
      overflow:hidden;
      transition:.8s var(--ease);
      position:relative;
    }
    .nav-item:hover{
      box-shadow:0 24px 60px rgba(0,0,0,.12);
    }
    .icon-wrap{
      width:58px;
      height:58px;
      border-radius:50%;
      background:var(--navy);
      display:flex;
      align-items:center;
      justify-content:center;
      margin-bottom:18px;
      transition:.8s var(--ease);
    }
    .icon-wrap svg{
      width:26px;
      height:26px;
      stroke:#fff;
      fill:none;
    }
    .nav-item:hover .icon-wrap{
      transform:translateY(-6px);
      box-shadow:0 10px 28px rgba(0,43,92,.35);
      background:#003a7c;
    }
    .nav-item h3{
      margin:0 0 6px;
      font-size:1.05rem;
      transition: transform .8s var(--ease), color .8s var(--ease);
    }
    .nav-item p{
      margin:0;
      font-size:.9rem;
      color:var(--gray);
      transition: transform .8s var(--ease), opacity .8s var(--ease);
    }
    .nav-item:hover h3{
      transform:translateY(-2px);
      color:var(--gold);
      transition-delay:.06s;
    }
    .nav-item:hover p{
      transform:translateY(-2px);
      opacity:.9;
      transition-delay:.12s;
    }

    /* CONTENT */
    .content{
      max-width:1100px;
      margin:120px auto;
      padding:0 24px;
    }
    .split{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:64px;
      align-items:center;
    }
    .split.reverse{direction:rtl}
    .split.reverse>*{direction:ltr}
    .split img{
      width:100%;
      border-radius:18px;
    }

    /* STORY */
    .card-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:36px;
    }
    .story-card{
      background:#fff;
      padding:30px;
      border-radius:18px;
      border-left:4px solid var(--gold);
      transition:.8s var(--ease);
    }
    .story-card:hover{
      box-shadow:0 22px 48px rgba(0,0,0,.12);
    }
    .story-card img{
      width:100%;
      border-radius:14px;
      margin-bottom:18px;
    }
    .meta{
      color:var(--gray);
      font-size:.9rem;
    }

    /* CTA */
    .cta{
      background:linear-gradient(to right,#002b5c,#003a7c);
      color:#fff;
      text-align:center;
      padding:110px 24px;
    }
    .cta-btn{
      display:inline-block;
      margin-top:26px;
      padding:15px 40px;
      border-radius:32px;
      background:#fff;
      color:#002b5c;
      font-weight:600;
      text-decoration:none;
      transition:.6s var(--ease);
    }
    .cta-btn:hover{
      transform:translateY(-2px);
      box-shadow:0 12px 30px rgba(0,0,0,.25);
    }

    /* PDPA */
    .pdpa{
      text-align:center;
      font-size:.85rem;
      color:#777;
      margin:72px 0;
    }
  </style>
</head>
<body>

  <!-- HERO -->
  <section class="hero" data-animate>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="season">Alumni Relations</p>
      <h2>ศิษย์เก่าวิทยาลัยศาสนศึกษา</h2>
      <p class="subtitle">College of Religious Studies, Mahidol University</p>
    </div>
  </section>

  <!-- NAVIGATION -->
  <section class="nav-section" data-animate>
    <div class="nav-grid">
