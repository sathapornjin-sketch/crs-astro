        <div class="icon-wrap">
          <svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/></svg>
        </div>
        <h3>ข่าวสารศิษย์เก่า</h3>
        <p>Alumni News & Updates</p>
      </a>
      <a href="#activities" class="nav-item">
        <div class="icon-wrap">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M4 20c0-4 16-4 16 0"/></svg>
        </div>
        <h3>กิจกรรม</h3>
        <p>Events & Engagement</p>
      </a>
      <a href="#privileges" class="nav-item">
