---
import Layout from '@/layouts/Layout.astro';
import Slogan from '@/components/sections/Slogan.astro';

const title = 'ศิษย์เก่า';
const description = 'วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล';
---

<Layout title={title} description={description}>
<Slogan title={title} description={description} />

<!-- HERO -->
<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <small>MAHIDOL UNIVERSITY</small>
    <h1>Alumni Network</h1>
    <p>
      เครือข่ายศิษย์เก่าวิทยาลัยศาสนศึกษา
    </p>
  </div>
</section>

<!-- NAVIGATION ICONS -->
<section class="nav-section">
  <div class="nav-grid">

    <a href="#news" class="nav-item">
      <svg class="lux-icon" viewBox="0 0 24 24">
        <rect x="4" y="3" width="16" height="18" rx="2"/>
        <line x1="7" y1="7" x2="17" y2="7"/>
        <line x1="7" y1="11" x2="17" y2="11"/>
        <line x1="7" y1="15" x2="13" y2="15"/>
      </svg>
      <h3>ข่าวสารศิษย์เก่า</h3>
      <p>Updates & Communications</p>
    </a>

    <a href="#activities" class="nav-item">
      <svg class="lux-icon" viewBox="0 0 24 24">
        <circle cx="12" cy="7" r="3"/>
        <path d="M5 21c0-4 14-4 14 0"/>
        <path d="M16 3c2 1 3 3 3 5"/>
      </svg>
      <h3>กิจกรรมและการมีส่วนร่วม</h3>
      <p>Engagement & Forum</p>
    </a>

    <a href="#privileges" class="nav-item">
      <svg class="lux-icon" viewBox="0 0 24 24">
        <path d="M12 3l8 4v6c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V7z"/>
      </svg>
      <h3>สิทธิประโยชน์</h3>
      <p>Privileges & Resources</p>
    </a>

    <a href="#network" class="nav-item">
      <svg class="lux-icon" viewBox="0 0 24 24">
        <circle cx="6" cy="12" r="2"/>
        <circle cx="18" cy="6" r="2"/>
        <circle cx="18" cy="18" r="2"/>
        <line x1="8" y1="12" x2="16" y2="6"/>
        <line x1="8" y1="12" x2="16" y2="18"/>
      </svg>
      <h3>เครือข่ายวิชาชีพ</h3>
      <p>Academic Collaboration</p>
    </a>

  </div>
</section>

<!-- NEWS -->
<section id="news" class="content-section split">
  <div class="text">
    <h2>ข่าวสารศิษย์เก่า</h2>
    <p>
      ถ่ายทอดบทบาท ความเคลื่อนไหว  
      และผลงานของศิษย์เก่าที่สร้างคุณค่าแก่สังคม
    </p>
  </div>
  <img src="https://images.unsplash.com/photo-1529070538774-1843cb3265df" />
</section>

<!-- ACTIVITIES -->
<section id="activities" class="content-section split reverse">
  <img src="https://images.unsplash.com/photo-1515187029135-18ee286d815b" />
  <div class="text">
    <h2>กิจกรรมและความร่วมมือ</h2>
    <p>
      เวทีการแลกเปลี่ยนองค์ความรู้  
      และการสร้างเครือข่ายเชิงยุทธศาสตร์
    </p>
  </div>
</section>

<!-- PRIVILEGES -->
<section id="privileges" class="content-section">
  <h2>สิทธิประโยชน์สำหรับศิษย์เก่า</h2>

 

</Layout>

<style>
:root {
  --gold:#8b6b2e;
  --dark:#1e1e1e;
  --light:#f6f5f2;
}

/* HERO */
.hero {
  position: relative;
  height: 560px;
  background:url("https://images.unsplash.com/photo-1523580846011-d3a5bc25702b") center/cover;
  display:flex;
  align-items:center;
  justify-content:center;
}
.hero-overlay {
  position:absolute;
  inset:0;
  background:linear-gradient(135deg,rgba(0,0,0,.75),rgba(0,0,0,.35));
}
.hero-content {
  position:relative;
  color:#fff;
  text-align:center;
  max-width:820px;
}
.hero-content h1 {
  font-size:3.6rem;
}

/* NAV */
.nav-section { margin-top:-120px; }
.nav-grid {
  max-width:1100px;
  margin:0 auto 180px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:36px;
}
.nav-item {
  background:rgba(255,255,255,.78);
  backdrop-filter:blur(10px);
  padding:44px 32px;
  border-radius:28px;
  text-decoration:none;
  color:var(--dark);
  box-shadow:0 30px 60px rgba(0,0,0,.12);
  transition:all .5s ease;
  position:relative;
  overflow:hidden;
}
.nav-item:hover {
  transform:translateY(-12px);
  box-shadow:0 40px 90px rgba(139,107,46,.35);
}
.nav-item::before {
  content:"";
  position:absolute;
  inset:0;
  background:radial-gradient(circle at top,rgba(139,107,46,.12),transparent 70%);
  opacity:0;
  transition:opacity .4s ease;
}
.nav-item:hover::before { opacity:1; }

/* SVG ICON */
.lux-icon {
  width:64px;
  height:64px;
  margin-bottom:18px;
  stroke:var(--gold);
  stroke-width:1.5;
  fill:rgba(139,107,46,.08);
  transition:
    transform .6s cubic-bezier(.22,.8,.25,1),
    stroke-width .4s ease,
    filter .4s ease,
    fill .4s ease;
}
.nav-item:hover .lux-icon {
  transform:translateY(-4px) scale(1.12);
  stroke-width:2.2;
  fill:rgba(139,107,46,.18);
  filter:
    drop-shadow(0 8px 18px rgba(139,107,46,.45))
    drop-shadow(0 2px 6px rgba(0,0,0,.15));
}

/* CONTENT */
.content-section {
  max-width:1100px;
  margin:180px auto;
}
.split {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:72px;
  align-items:center;
}
.split.reverse { direction:ltr; }
.split img {
  width:100%;
  border-radius:32px;
}

/* BENEFITS */
.benefit-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:40px;
  margin-top:56px;
}
.benefit-card {
  background:var(--light);
  border-radius:32px;
  overflow:hidden;
  box-shadow:0 28px 60px rgba(0,0,0,.14);
  transition:transform .4s ease;
}
.benefit-card:hover { transform:translateY(-10px); }
.benefit-card img {
  width:100%;
  height:200px;
  object-fit:cover;
}
.benefit-card h4 { margin:26px; }
.benefit-card p {
  margin:0 26px 32px;
  color:#555;
}
</style>
