---
import Layout from '@/layouts/Layout.astro';

const title = "วิทยาลัยศาสนศึกษา ร่วมพิธีเปิดและมอบรางวัลการประกวดตั้งชื่อและออกแบบลวดลายรถบัสพลังงานไฟฟ้า";
const date = "22 ธันวาคม 2568";
const description = "";
const gallery = [
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-1.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-2.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-3.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-4.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-5.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-6.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-7.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-8.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-9.jpg",
  "/img/activities/dec2025/22dec2025activities/22dec2025activities-10.jpg",    
]
 
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1>{title}</h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>   

    <p>
วันที่ 22 ธันวาคม 2568 กองกายภาพและสิ่งแวดล้อม มหาวิทยาลัยมหิดล จัดพิธีเปิดและมอบรางวัลการประกวดตั้งชื่อและออกแบบลวดลายรถบัสพลังงานไฟฟ้าอย่างเป็นทางการ ณ บริเวณหน้าอาคารสำนักงานอธิการบดี โดยได้รับเกียรติจาก ศ.นพ.ปิยะมิตร ศรีธรา อธิการบดีมหาวิทยาลัยมหิดล เป็นประธานในพิธี และ ผศ.ดร.อิทธิโชติ จักรไพวงศ์ รองอธิการบดีฝ่ายกายภาพและสิ่งแวดล้อม เป็นผู้กล่าวรายงานวัตถุประสงค์การจัดงาน<br>
​ในการนี้ อ.ดร.บุญมี พวงเพชร อาจารย์ประจำวิทยาลัยศาสนศึกษา ได้เข้าร่วมเป็นเกียรติในพิธีดังกล่าว เพื่อร่วมแสดงความยินดีแก่ผู้ได้รับรางวัลและสนับสนุนนโยบายด้านสิ่งแวดล้อมของมหาวิทยาลัยมหิดล
</p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
          src={src} 
          style="width:100%; height:220px; object-fit:cover; border-radius:6px; cursor:pointer;" 
          onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
        />
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
</Layout>