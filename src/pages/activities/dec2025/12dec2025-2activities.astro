---
import Layout from '@/layouts/Layout.astro';

const title = "วิทยาลัยศาสนศึกษาร่วมแสดงความยินดี เนื่องในงานวันคล้ายวันสถาปนาคณะสังคมศาสตร์และมนุษยศาสตร์ ครบรอบ 56 ปี ";
const date = "12 ธันวาคม 2568";
const description = "";
const gallery = [
  "/img/activities/dec2025/12dec2025-2activities/12dec2025-2activities-1.jpg",
  "/img/activities/dec2025/12dec2025-2activities/12dec2025-2activities-2.jpg",
  "/img/activities/dec2025/12dec2025-2activities/12dec2025-2activities-3.jpg", 
]
 
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1>{title}</h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>   

    <p>วันที่ 12 ธันวาคม 2568 Assoc. Prof. Dr. Milos Hubina รองคณบดีฝ่ายวิจัยและวิเทศสัมพันธ์ วิทยาลัยศาสนศึกษา ร่วมแสดงความยินดี เนื่องในงานวันคล้ายวันสถาปนาคณะสังคมศาสตร์และมนุษยศาสตร์ ครบรอบ 56 ปี โดยมี ศาสตราจารย์ ดร.พรรณชฎา ศิริวรรณบุศย์ คณบดีคณะสังคมศาสตร์และมนุษยศาสตร์ให้การต้อนรับ ณ อาคารคณะสังคมศาสตร์และมนุษยศาสตร์ มหาวิทยาลัยมหิดล<br>
<br>
College of Religious Studies Congratulates Faculty of Social Sciences and Humanities on Its 56th Anniversary<br>
On 12 December 2025, Assoc. Prof. Dr. Milos Hubina, Associate Dean for Research and International Relations of the College of Religious Studies, extended his congratulations on the occasion of the 56th anniversary of the Faculty of Social Sciences and Humanities. He was warmly welcomed by Prof. Dr. Phanchada Siriwanbusaya, Dean of the Faculty of Social Sciences and Humanities, at the Faculty of Social Sciences and Humanities Building, Mahidol University.
 
</p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
          src={src} 
          style="width:100%; height:220px; object-fit:cover; border-radius:6px; cursor:pointer;" 
          onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
        />
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
</Layout>