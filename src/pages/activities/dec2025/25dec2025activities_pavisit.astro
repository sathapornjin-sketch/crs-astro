---
import Layout from '@/layouts/Layout.astro';

const title = "คณะผู้บริหารมหาวิทยาลัยมหิดล รับฟังรายงานผลการดำเนินงานตามข้อตกลงการปฏิบัติงาน (PA-Visit) ประจำปีงบประมาณ 2569 วิทยาลัยศาสนศึกษา";
const date = "25 ธันวาคม 2568";
const description = "";
const gallery = [
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-1.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-2.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-3.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-4.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-5.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-6.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-7.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-8.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-9.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-10.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-11.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-12.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-13.jpg",
  "/img/activities/dec2025/25dec2025activities_pavisit/25dec2025activities_pavisit-14.jpg",  
]
 
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1>{title}</h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>   

    <p>    
    
วันที่ 25 ธันวาคม 2568 ศาสตราจารย์ นพ.ปิยะมิตร ศรีธรา อธิการบดีมหาวิทยาลัยมหิดล นำคณะผู้บริหารมหาวิทยาลัยเข้ารับฟังการรายงานผลการดำเนินงานตามข้อตกลงการปฏิบัติงาน (PA-Visit) ประจำปีงบประมาณ 2569 ของวิทยาลัยศาสนศึกษา เพื่อร่วมแลกเปลี่ยนทิศทางการพัฒนาและขับเคลื่อนยุทธศาสตร์ส่วนงานสู่ระดับสากล<br>
ในโอกาสนี้ ผู้ช่วยศาสตราจารย์ ดร.ไพเราะ มากเจริญ คณบดีวิทยาลัยศาสนศึกษา พร้อมด้วยทีมบริหาร ได้นำเสนอความสำเร็จและผลงานโดดเด่นในรอบปีที่ผ่านมา ซึ่งสะท้อนถึงศักยภาพของวิทยาลัยในการบูรณาการองค์ความรู้ด้านศาสนศึกษาเข้ากับบริบทโลกยุคใหม่ พร้อมทั้งรับฟังข้อเสนอแนะเชิงนโยบายเพื่อเพิ่มประสิทธิภาพการดำเนินงานในปีงบประมาณ 2569 ณ ห้องประชุมน้ำทอง คุณวิศาล วิทยาลัยศาสนศึกษา
<br><br>
The Executive Board of Mahidol University Receives the Performance Agreement (PA-Visit) Report for Fiscal Year 2026 from the College of Religious Studies<br>
On 25 December 2025, Professor Piyamitr Sritara, M.D., President of Mahidol University, together with the university executive team, attended a briefing on the Performance Agreement (PA-Visit) implementation report for Fiscal Year 2026 presented by the College of Religious Studies. The meeting aimed to exchange views on development directions and to drive the College’s strategic initiatives toward international standards.<br>
On this occasion, Assistant Professor Dr. Pairor Makcharoen, Dean of the College of Religious Studies, along with the management team, presented the College’s key achievements and outstanding performance over the past year. The presentation reflected the College’s capacity to integrate knowledge in religious studies with contemporary global contexts. The session also included policy-level recommendations to enhance operational effectiveness for Fiscal Year 2026. The meeting was held at Namthong Khun Wisal Conference Room, College of Religious Studies.

    </p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
          src={src} 
          style="width:100%; height:220px; object-fit:cover; border-radius:6px; cursor:pointer;" 
          onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
        />
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
</Layout>