---
import Layout from '@/layouts/Layout.astro';

const title = "มหาวิทยาลัยมหิดล จัดพิธีทำบุญตักบาตร เนื่องในวันขึ้นปีใหม่ 2569";
const date = "26 ธันวาคม 2568";
const description = "";
const gallery = [
  "/img/activities/dec2025/26dec2025activities/26dec2025activities-1.jpg",
  "/img/activities/dec2025/26dec2025activities/26dec2025activities-2.jpg",
  "/img/activities/dec2025/26dec2025activities/26dec2025activities-3.jpg",
  "/img/activities/dec2025/26dec2025activities/26dec2025activities-4.jpg",
  "/img/activities/dec2025/26dec2025activities/26dec2025activities-5.jpg",
  "/img/activities/dec2025/26dec2025activities/26dec2025activities-6.jpg",  
]
 
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1>{title}</h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>   

    <p>     
วันที่ 26 ธันวาคม 2568 ศาสตราจารย์ ดร. เภสัชกรสมภพ ประธานธุรารักษ์ รองอธิการบดีฝ่ายแผนกลยุทธ์ พัฒนาคุณภาพและพันธกิจเพื่อสังคม มหาวิทยาลัยมหิดล เป็นประธานในพิธีทำบุญตักบาตร เนื่องในวันขึ้นปีใหม่ 2569 โดยมีคณะผู้บริหารมหาวิทยาลัยมหิดล ผู้บริหารส่วนงาน อาจารย์ และบุคลากรจากทุกส่วนงานร่วมพิธี <br>
ในการนี้ ผู้ช่วยศาสตราจารย์ ดร.ไพเราะ มากเจริญ คณบดีวิทยาลัยศาสนศึกษา และบุคลากรของวิทยาลัยศาสนศึกษาได้ร่วมพิธีทำบุญตักบาตรพระภิกษุสงฆ์-สามเณร จำนวน 30 รูป ณ หอพระพุทธมหาสิริพีรยพัฒน์ มหาวิทยาลัยมหิดล ศาลายา
<br><br>
Mahidol University Holds Alms-Giving Ceremony to Mark the New Year 2026<br>
On 26 December 2025, Professor Dr. Somphop Prathanthurarak, Vice President for Strategic Planning, Quality Development, and Social Engagement, Mahidol University, presided over the alms-giving ceremony held in celebration of the New Year 2026. The ceremony was attended by members of the university executive team, administrators of various faculties, lecturers, and staff from all units of Mahidol University. <br>
On this occasion, Assistant Professor Dr. Phairoj Makcharoen, Dean of the College of Religious Studies, together with staff of the College of Religious Studies, participated in the alms-giving to 30 monks and novice monks at the Phra Phuttha Maha Siripeerayaphat Hall, Mahidol University, Salaya Campus.
</p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
          src={src} 
          style="width:100%; height:220px; object-fit:cover; border-radius:6px; cursor:pointer;" 
          onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
        />
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
</Layout>