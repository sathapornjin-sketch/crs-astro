---
import Layout from '@/layouts/Layout.astro';

const title = "วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล ร่วมแสดงมุทิตาสักการะและความยินดีแด่ศิษย์เก่าผู้ทรงคุณค่า";
const date = "2 มีนาคม 2569";
const description = "";
const gallery = [
  "/img/activities/2026/mar2026/2mar2026activities2/2mar2026activities2-1.jpg",
  "/img/activities/2026/mar2026/2mar2026activities2/2mar2026activities2-2.jpg",
  "/img/activities/2026/mar2026/2mar2026activities2/2mar2026activities2-3.jpg",
  "/img/activities/2026/mar2026/2mar2026activities2/2mar2026activities2-4.jpg",
  "/img/activities/2026/mar2026/2mar2026activities2/2mar2026activities2-5.jpg",
  "/img/activities/2026/mar2026/2mar2026activities2/2mar2026activities2-6.jpg",    
  ]
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1 set:html={title}></h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>   

    <p>   
วันที่ 2 มีนาคม 2569 ณ สำนักงานอธิการบดี มหาวิทยาลัยมหิดล ศาลายา ได้มีพิธีมอบรางวัล Mahidol University Alumni Awards 2026 เพื่อแสดงความยินดีแด่ศิษย์เก่าผู้ได้รับรางวัลอันทรงเกียรติ โดยในปีนี้ วิทยาลัยศาสนศึกษา มีศิษย์เก่าที่ได้รับรางวัลดังต่อไปนี้<br>
พระราชวชิราธิบดี (สุรศักดิ์ ธมมรสี ป.ธ.5)<br>
ได้รับ รางวัลศิษย์เก่าดีเด่น (Mahidol University Alumni Awards 2026)<br>
ร.ต.อ.ภานุวัฒน์ เนียมบาง<br>
ได้รับ รางวัลศิษย์เก่ารุ่นใหม่ดีเด่น (Mahidol University Young Alumni Awards 2026)<br>
ในโอกาสนี้ อ.ดร.บุญมี พวงเพชร ได้เข้าร่วมแสดงความยินดีในงานดังกล่าว ซึ่งเป็นช่วงเวลาสำคัญที่สะท้อนถึงความสำเร็จและบทบาทของศิษย์เก่าที่สร้างคุณูปการให้แก่สังคม<br>
วิทยาลัยศาสนศึกษาขอแสดงความยินดีและภาคภูมิใจในศิษย์เก่าของเราทั้งสองท่าน และขอให้เป็นแรงบันดาลใจแก่ศิษย์ปัจจุบันและศิษย์เก่าทุกท่านในการสร้างสรรค์คุณประโยชน์แก่สังคมต่อไป
</p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
  src={src} 
  style="width:100%; height:auto; object-fit:contain; border-radius:6px; cursor:pointer;" 
  onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
/>
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
