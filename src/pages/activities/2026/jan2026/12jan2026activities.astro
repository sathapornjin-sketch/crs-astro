---
import Layout from '@/layouts/Layout.astro';

const title = "วิทยาลัยศาสนศึกษาร่วมแสดงความยินดี เนื่องในงานวันคล้ายวันครบรอบ 129 ปี คณะพยาบาลศาสตร์ มหาวิทยาลัยมหิดล (โรงเรียนหญิงแพทย์ผดุงครรภ์แลการพยาบาลไข้)";
const date = "12 มกราคม 2569";
const description = "";
const gallery = [
  "/img/activities/2026/jan2026/12jan2026activities/12jan2026activities-1.jpg",
  "/img/activities/2026/jan2026/12jan2026activities/12jan2026activities-2.jpg",
  "/img/activities/2026/jan2026/12jan2026activities/12jan2026activities-3.jpg",
  "/img/activities/2026/jan2026/12jan2026activities/12jan2026activities-4.jpg",
]
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1>{title}</h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>   

    <p>   
วันที่ 12 มกราคม 2569 Assoc. Prof. Dr. Milos Hubina รองคณบดีฝ่ายวิจัยและวิเทศสัมพันธ์ วิทยาลัยศาสนศึกษา ร่วมแสดงความยินดีและร่วมฟังปาฐกถาคุณหญิงพิณพากย์พิทยาเภท ครั้งที่ 25 
เรื่อง "อนาคตวิชาชีพพยาบาล: ปฏิรูปการศึกษาเพื่อสร้างกำลังคนที่เท่าเทียมและยั่งยืน" เนื่องในงานวันคล้ายวันครบรอบ 129 ปี คณะพยาบาลศาสตร์ มหาวิทยาลัยมหิดล (โรงเรียนหญิงแพทย์ผดุงครรภ์แลการพยาบาลไข้) 
โดยมี รศ.ดร.อรวมน ศรียุกตศุทร รองคณบดีฝ่ายบัณฑิตศึกษา คณะพยาบาลศาสตร์ ให้การต้อนรับ ณ ห้องประชุมภัทรมหาราชการุณย์ ชั้น 5 คณะพยาบาลศาสตร์ มหาวิทยาลัยมหิดล ศาลายา<br>
<br><br>
College of Religious Studies Congratulates the Faculty of Nursing on Its 129th Anniversary<br>
On 12 January 2026, Assoc. Prof. Dr. Milos Hubina, Deputy Dean for Research and International Relations, College of Religious Studies, Mahidol University, attended the celebration of the 129th anniversary of the Faculty of Nursing, Mahidol University (formerly the School of Midwifery and Nursing). On this occasion, he also joined the 25th Khunying Phinphak Phitthayaphet Lecture entitled “The Future of the Nursing Profession: Reforming Education to Build an Equitable and Sustainable Workforce.”<br>
The event was warmly welcomed by Assoc. Prof. Dr. Arawan Sriyuktasut, Deputy Dean for Graduate Studies, Faculty of Nursing, Mahidol University, at Bhattramaharat Karun Hall, 5th Floor, Faculty of Nursing, Mahidol University, Salaya Campus
</p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
          src={src} 
          style="width:100%; height:220px; object-fit:cover; border-radius:6px; cursor:pointer;" 
          onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
        />
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
</Layout>