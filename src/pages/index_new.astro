<section class="pb-16">
  <div class="max-w-7xl mx-auto px-4
              grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3
              gap-8">

    <a href="https://crs.mahidol.ac.th/education/syllabus" class="card group">
      <img src="img/mucrs_courses.png" width="220" height="220" />
      <h4>หลักสูตร</h4>
    </a>

    <a href="/news" class="card group">
      <img src="img/mucrs_news.png" width="220" height="220" />
      <h4>ข่าวสาร CRS</h4>
    </a>

    <a href="https://crs.mahidol.ac.th/seminar" class="card group">
      <img src="img/seminar/25jul2025/25jul2025-1.jpg" />
      <h4>สัมมนาและบรรยายทางวิชาการ</h4>
    </a>

    <a href="https://crs.mahidol.ac.th/students" class="card group">
      <img src="img/students/oct2025/10oct2025/10oct2025-4.jpg"/>
      <h4>นักศึกษา CRS Students</h4>
    </a>

    

    <a href="https://crs.mahidol.ac.th/activities" class="card group">
      <img src="img/activities/sep2025/24sep2025-1.jpg" />
      <h4>กิจกรรม</h4>
    </a>

    <a href="https://crs.mahidol.ac.th/birth" class="card group">
      <img src="img/birth/nov2025/28nov2025birth-1.jpg" />
      <h4>ทำบุญเดือนเกิด</h4>
    </a>

  </div>
</section>


<style>
.card {
  @apply bg-white rounded-[2rem]
         p-6 sm:p-8 md:p-10
         text-center border
         min-h-[220px]
         flex flex-col items-center justify-center
         transition-all duration-300
         hover:-translate-y-2
         hover:shadow-[0_18px_36px_rgba(0,0,0,0.12)];
}

.icon {
  @apply w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20
         mx-auto mb-4 sm:mb-6
         transition-transform duration-300
         group-hover:scale-110;
}

.card h4 {
  @apply text-xs sm:text-sm
         font-normal text-black
         tracking-wider text-center;
}

</style>

	

	



