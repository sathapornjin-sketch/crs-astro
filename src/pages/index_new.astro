---
import YoutubeVideo from '@/components/plugins/YoutubeVideo.astro';
import Banner from '@/components/sections/Banner.astro';
import Features from '@/components/sections/Features.astro';
import Hero from '@/components/sections/Hero.astro';
import Logos from '@/components/sections/Logos.astro';
import Slogan from '@/components/sections/Slogan.astro';
import Title1 from '@/components/sections/Title1.astro';
import Title2 from '@/components/sections/Title2.astro';
import Layout from '@/layouts/Layout.astro';
import FacebookPage from '@/components/plugins/FacebookPage.astro';
import Information from '@/components/sections/Information.astro';
import Congratulation from '@/components/sections/Congratulation.astro';
import Activities from '@/components/sections/Activities.astro';
import Seminar from '@/components/sections/Seminar.astro';
//import Calendar from '@/components/sections/Calendar.astro';

import Popup from '@/components/sections/Popup.astro';
// const res = await fetch('https://seedx.seeddemo.com/wp-json/wp/v2/posts?per_page=3&_embed');
// const posts = await res.json();

const metadata = {
	title: 'วิทยาลัยศาสนศึกษา – มหาวิทยาลัยมหิดล',
	description: 'College of Religious Studies, Mahidol University',
};

---

<Layout

	title={metadata.title}
	description={metadata.description}
	bodyclass="bg-white dark:bg-th-bg-2-dark"
>
	<Banner />
    <Popup />	
	<Information />
	<Congratulation />
	<Activities />
	<Seminar />
	
	
	<Title2 title="วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล" description="" />

<section class="-mt-12 pb-12">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-10">

    <a href="/about/history" class="card">
      <img src="img/mucrshistory.png" />
      <h4>ประวัติความเป็นมา</h4>
    </a>

    <a href="/about/vision" class="card">
      <img src="img/mucrs_mv.png" width="180" height="180" />
      <h4>พันธกิจและวิสัยทัศน์</h4>
    </a>

    <a href="https://www.facebook.com/CRSNamthong" target="_blank" class="card">
      <img src="img/ntdorm.jpg" width="180" height="180"/>
      <h4>มูลนิธิและหอพักน้ำทองสิกขาลัย</h4>
    </a>

  </div>
</section>

<style>
.card {
  @apply bg-white rounded-[4rem] p-10 text-center border
         transition-all duration-300
         hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.12)]
         hover:bg-gradient-to-b hover:from-white hover:to-gray-50;
}

.icon {
  @apply w-32 h-32 mx-auto mb-6
         transition-transform duration-300
         group-hover:scale-110;
}

.card h4 {
  @apply text-base font-normal text-black tracking-wide;
}
</style>








