---
import Layout from '@/layouts/Layout.astro';
const title = "วิทยาลัยศาสนศึกษา มหิดล จับมือ 4 สถาบันชั้นนำ พัฒนา หลักสูตรร่วมแบบบูรณาการเสริมสร้างความร่วมมือทางวิชาการข้ามศาสตร์";
const date = "18 ธันวาคม 2568";
const description = "";
const gallery = [
  "/img/collab/dec2025/18dec2025collab/18dec2025collab-1.jpg",
  "/img/collab/dec2025/18dec2025collab/18dec2025collab-2.jpg",
  "/img/collab/dec2025/18dec2025collab/18dec2025collab-3.jpg",
  "/img/collab/dec2025/18dec2025collab/18dec2025collab-4.jpg",
  "/img/collab/dec2025/18dec2025collab/18dec2025collab-5.jpg", 
     ];
---

<Layout title={title} description={description}>
  <article style="max-width:800px; margin:40px auto; padding:0 20px;">
    <h1>{title}</h1>
    <p style="color:#555; font-size:0.9rem;">{date}</p>

    <p>{description}</p>
    

    <p>
วันที่ 18 ธันวาคม 2568 วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล จัดประชุมหารือแนวทางพัฒนา "หลักสูตรร่วมแบบบูรณาการ" (Integrated Joint Degree) 
มุ่งเน้นการเชื่อมโยงองค์ความรู้ด้านศาสนา ปรัชญา มนุษยศาสตร์ เข้ากับสิทธิมนุษยชน 
การพัฒนาเด็ก ประชากรศาสตร์ และการพัฒนาด้านสุขภาพอาเซียน เพื่อผลิตบัณฑิตที่มีสมรรถนะรอบด้านในระดับสากล 
โดยมี ผศ.ดร.ไพเราะ มากเจริญ คณบดีวิทยาลัยศาสนศึกษา พร้อมด้วย อ.ดร.จิราธร ชาติศิริ รองคณบดีฝ่ายการศึกษาและกิจการนักศึกษา เปิดการประชุมเพื่อกำหนดทิศทางการศึกษาแนวใหม่ อันจะนำไปสู่การพัฒนาหลักสูตรร่วมแบบบูรณาการที่มีความเข้มแข็ง ทันสมัย และมีศักยภาพในการตอบสนองต่อการพัฒนาสังคมในระดับประเทศอย่างยั่งยืน ซึ่งการประชุมครั้งนี้ได้รับความร่วมมือจากผู้บริหารและคณาจารย์ผู้ทรงคุณวุฒิจาก 4 ส่วนงานสำคัญของมหาวิทยาลัยมหิดล เพื่อแลกเปลี่ยนมุมมองเชิงวิชาการ ได้แก่: <br>
1. สถาบันสิทธิมนุษยชนและสันติศึกษา นำโดย ผศ.ดร.นภารัตน์ กรรณรัตนสูตร เลขานุการหลักสูตรศิลปศาสตรมหาบัณฑิต (ภาคพิเศษ)<br>
อ.ดร.พลธรรม์ จันทร์คำ ประธานหลักสูตรศิลปศาสตรมหาบัณฑิต (ภาคพิเศษ)<br>
และคุณมานียา รักษาผล นักวิชาการศึกษา หลักสูตรศิลปศาสตรมหาบัณฑิต (ภาคพิเศษ)<br>
2. สถาบันแห่งชาติเพื่อการพัฒนาเด็กและครอบครัว นำโดย อ.ดร.ธีรตา ขำนอง ประธานคณะกรรมการบริหารหลักสูตรวิทยาศาสตรมหาบัณฑิต สาขาวิชาพัฒนาการมนุษย์ (ภาคปกติและภาคพิเศษ)
และอ.ธนวัฒน์ ธรรมโชติ อาจารย์ประจำสถาบันแห่งชาติเพื่อการพัฒนาเด็กและครอบครัว<br>
3. สถาบันวิจัยประชากรและสังคม
 นำโดย ผศ.ดร.นุชราภรณ์ เลี้ยงรื่นรมย์ รองผู้อำนวยการฝ่ายวิชาการ
และคุณนัทชา แขกวันวงค์ นักวิชาการศึกษา<br>
4. สถาบันพัฒนาสุขภาพอาเซียน
โดยมุ่งหวังว่าหลักสูตรบูรณาการนี้จะเป็นต้นแบบสำคัญในการผลิตบัณฑิตที่เชื่อมโยงองค์ความรู้ด้านศาสนา ปรัชญา มนุษยศาสตร์  สิทธิมนุษยชน การพัฒนาเด็ก ประชากรศาสตร์ และการพัฒนาด้านสุขภาพอาเซียน เพื่อยกระดับคุณภาพการจัดการศึกษาและการผลิตบัณฑิตให้มีสมรรถนะรอบด้านต่อไป
</p>
    <!-- Grid รูปเล็ก -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; margin-top:20px;">
      {gallery.map((src, index) => (
        <img 
          src={src} 
          style="width:100%; height:220px; object-fit:cover; border-radius:6px; cursor:pointer;" 
          onclick={`document.getElementById('lb').style.display='flex'; document.getElementById('lb-img').src='${src}'`} 
        />
      ))}
    </div>

    <!-- Lightbox -->
    <div id="lb" style="
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.8);
      justify-content:center;
      align-items:center;
      z-index:9999;
      flex-direction:column;
    ">
      <button id="lb-close" style="
        position:absolute;
        top:20px;
        right:20px;
        font-size:2rem;
        color:white;
        background:none;
        border:none;
        cursor:pointer;
      ">×</button>
      <img id="lb-img" src="" style="max-width:90%; max-height:90%; border-radius:6px;" />
    </div>

    <script type="text/javascript">
      const lb = document.getElementById('lb');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      lbClose.addEventListener('click', () => { lb.style.display = 'none'; });
      lb.addEventListener('click', e => { if(e.target === lb) lb.style.display = 'none'; });
    </script>
  </article>
</Layout>
</Layout>