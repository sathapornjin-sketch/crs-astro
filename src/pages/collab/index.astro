---
import Layout from '@/layouts/Layout.astro';
import Slogan from '@/components/sections/Slogan.astro';

const title = 'การประชุมเครือข่ายความร่วมมือทางวิชาการ - Academic Collaboration Network Meetings';
const description = 'วิทยาลัยศาสนศึกษา';

const articles = [
  {
    title: "วิทยาลัยศาสนศึกษา ม.มหิดล จับมือวิทยาลัยในวัง เดินหน้าพัฒนาวิชาโทและงานบริการวิชาการ บูรณาการศาสนากับศิลปวัฒนธรรมไทย <br> College of Religious Studies, Mahidol University and Witthayalai Nai Wang Initiate Collaboration on Minor Program and Academic Services Integrating Religion and Thai Cultural Heritage",
    date: "26 กุมภาพันธ์ 2569",
    slug: "2026collab/feb2026collab/26feb2026collab",
    image: "/img/collab/2026collab/feb2026collab/26feb2026collab/26feb2026collab-1.jpg"
  },
  {
    title: "วิทยาลัยศาสนศึกษา มหิดล จับมือ 4 สถาบันชั้นนำ พัฒนา หลักสูตรร่วมแบบบูรณาการเสริมสร้างความร่วมมือทางวิชาการข้ามศาสตร์ ประชุมหารือแนวทางพัฒนา หลักสูตรร่วมแบบบูรณาการ (Integrated Joint Degree) มุ่งเน้นการเชื่อมโยงองค์ความรู้ด้านศาสนา ปรัชญา มนุษยศาสตร์ เข้ากับสิทธิมนุษยชน การพัฒนาเด็ก ประชากรศาสตร์ และการพัฒนาด้านสุขภาพอาเซียน เพื่อผลิตบัณฑิตที่มีสมรรถนะรอบด้านในระดับสากล ",
    date: "18 ธันวาคม 2568",
    slug: "dec2025collab/18dec2025collab",
    image: "/img/collab/dec2025/18dec2025collab/18dec2025collab-3.jpg"
  }
];
---
<Layout title={title} description={description}>
  <Slogan title={title} description={description} />

  <section style="max-width:1100px; margin:0 auto; padding:0 20px;">
    <h2 style="margin-bottom:20px;">การประชุมเครือข่ายความร่วมมือทางวิชาการ - Academic Cooperation Network Meeting</h2>

    <div
      style="
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(320px, 420px));
        gap:24px;
        justify-content:flex-start;
      "
    >
      {articles.map(article => (
        <a
          href={`/collab/${article.slug}`}
           target="_blank"
          style="
            display:block;
            text-decoration:none;
            color:inherit;
            border:1px solid #e0e0e0;
            border-radius:10px;
            overflow:hidden;
            background:#fff;
            transition:transform .25s, box-shadow .25s;
          "
          onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 24px rgba(0,0,0,.12)';"
          onmouseout="this.style.transform='none'; this.style.boxShadow='none';"
        >
          <img
            src={article.image}
            alt={article.title}
            style="
              width:100%;
              height:240px;
              object-fit:cover;
            "
          />

          <div style="padding:14px 16px;">
            <h3
              style="margin:0; font-size:1rem; line-height:1.4; font-weight:300"
              set:html={article.title}
            ></h3>
            <p style="margin-top:6px; font-size:.85rem; color:#666;">
              {article.date}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
