---
import Icon from 'astro-icon';
import Image from './ui/Image.astro';

const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');

interface MenuItem {
	name: string;
	link: string;
	isExternal?: boolean;
}

interface SocialIcon {
	icon: string;
	link: string;
}

/* ===============================
   TEXT (TH / EN)
================================ */
const footerText = isEn
	? {
			collegeName1: 'College of Religious Studies',
			collegeName2: 'Mahidol University',
			address:
				'999 Phutthamonthon Sai 4 Rd., Salaya, Phutthamonthon, Nakhon Pathom 73170, Thailand',
			tel: 'Tel. +66 2 800-2630-9',
			fax: 'Fax. +66 2 800-2659',
			emailLabel: 'E-mail',
			copyright: 'All Rights Reserved.',
	  }
	: {
			collegeName1: 'วิทยาลัยศาสนศึกษา',
			collegeName2: 'มหาวิทยาลัยมหิดล',
			address:
				'999 ถนนพุทธมณฑลสาย 4 ตำบลศาลายา อำเภอพุทธมณฑล จังหวัดนครปฐม 73170',
			tel: 'Tel. (02) 800-2630-9',
			fax: 'Fax. (02) 800-2659',
			emailLabel: 'E-mail',
			copyright: 'สงวนลิขสิทธิ์',
	  };

/* ===============================
   MENUS (TH / EN)
================================ */
const mainMenus: MenuItem[] = isEn
	? [
			{ name: 'Home', link: '/en' },
			{ name: 'About CRS', link: '/en/about' },
			{ name: 'Projects', link: '#' },
			{
				name: 'News',
				link: 'https://www.facebook.com/CrsMahidol',
				isExternal: true,
			},
			{ name: 'Articles', link: '#' },
	  ]
	: [
			{ name: 'หน้าแรก', link: '/' },
			{ name: 'เกี่ยวกับวิทยาลัย', link: '/about' },
			{ name: 'เกี่ยวกับโครงการ', link: '#' },
			{
				name: 'ข่าวประชาสัมพันธ์',
				link: 'https://www.facebook.com/CrsMahidol',
				isExternal: true,
			},
			{ name: 'บทความ', link: '#' },
	  ];

const subMenus: MenuItem[] = isEn
	? [
			{
				name: 'Careers',
				link: 'https://muhr.mahidol.ac.th/E-Recruitment/',
				isExternal: true,
			},
			{ name: 'Photo Gallery', link: '#' },
			{ name: 'Public Documents', link: '#' },
			{ name: 'Contact Us', link: '#' },
			{ name: 'Complaints', link: '#' },
			{ name: 'FAQ', link: '#' },
	  ]
	: [
			{
				name: 'ร่วมงานกับเรา',
				link: 'https://muhr.mahidol.ac.th/E-Recruitment/',
				isExternal: true,
			},
			{ name: 'คลังภาพกิจกรรม', link: '#' },
			{ name: 'เอกสารเผยแพร่', link: '#' },
			{ name: 'ติดต่อเรา', link: '#' },
			{ name: 'แจ้งเรื่องร้องเรียน', link: '#' },
			{ name: 'คำถามที่พบบ่อย', link: '#' },
	  ];

const socialIcons: SocialIcon[] = [
	{
		icon: 'facebook',
		link: 'https://www.facebook.com/CrsMahidol',
	},
	{
		icon: 'twitter',
		link: 'https://twitter.com/crs_mu',
	},
	{
		icon: 'line',
		link: 'https://line.me/ti/p/@296qyxeq',
	},
	{
		icon: 'instagram',
		link: 'https://www.instagram.com/crsaofficial',
	},
	{
		icon: 'youtube',
		link: 'https://www.youtube.com/@crsaofficial8648',
	},
];
---

<footer id="foot" class="mt-auto">
	<div class="bg-th-bg-5 text-white dark:bg-th-bg-5-dark">
		<div
			class="mx-auto flex w-full max-w-th-width-lg flex-row flex-wrap justify-between px-4 py-10 pb-10 md:px-5 md:pb-5 lg:pb-6 xl:pb-16"
		>
			<!-- LEFT : LOGO + ADDRESS -->
			<div class="basis-full lg:basis-[unset]">
				<div class="flex items-center">
					<div class="flex h-16 w-16 items-center justify-center rounded-full bg-white">
						<Image src="/img/mu-logo.png" alt="logo" classes="aspect-square" />
					</div>
					<div class="mb-0 ml-5 text-3xl font-normal">
						<div>{footerText.collegeName1}</div>
						<div class="text-xl">{footerText.collegeName2}</div>
					</div>
				</div>

				<div class="mb-0 max-w-[430px] pt-6">
					<div>{footerText.collegeName1} {footerText.collegeName2}</div>
					<div>{footerText.address}</div>
					<div>{footerText.tel}</div>
					<div>{footerText.fax}</div>
					<div>
						{footerText.emailLabel} :
						<a
							href="mailto:crs@mahidol.ac.th"
							class="text-white hover:text-th-nav-text hover:opacity-80"
							>crs@mahidol.ac.th</a
						>
					</div>
				</div>
			</div>

			<!-- MAIN MENU -->
			<div class="basis-2/4 pt-6 lg:basis-[unset] lg:pt-0">
				<ul class="m-0 p-0">
					{mainMenus.map((i) => (
						<li>
							<a
								href={i.link}
								target={i.isExternal ? '_blank' : '_self'}
								class="leading-7 text-white hover:text-th-nav-text hover:opacity-80"
							>
								{i.name}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- SUB MENU -->
			<div class="basis-2/4 pt-6 lg:basis-[unset] lg:pt-0">
				<ul class="m-0 p-0">
					{subMenus.map((i) => (
						<li>
							<a
								href={i.link}
								target={i.isExternal ? '_blank' : '_self'}
								class="block leading-7 text-white hover:text-th-nav-text hover:opacity-80"
							>
								{i.name}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- SOCIAL + MAP -->
			<div>
				<ul class="m-0 mt-1 flex gap-3 p-0">
					{socialIcons.map((i) => (
						<li>
							<a
								href={i.link}
								class="text-white hover:text-th-nav-text hover:opacity-80"
								target="_blank"
								aria-label={i.icon}
							>
								<Icon name={i.icon} width="24px" height="24px" />
							</a>
						</li>
					))}
				</ul>

				<iframe
					src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15498.694265972106!2d100.3186385!3d13.7985415!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30e2938fadcb950f%3A0x9ff2f12100df190a!2z4Lin4Li04LiX4Lii4Liy4Lil4Lix4Lii4Lio4Liy4Liq4LiZ4Lio4Li24LiB4Lip4LiyIOC4oeC4q-C4suC4p-C4tOC4l-C4ouC4suC4peC4seC4ouC4oeC4q-C4tOC4lOC4pQ!5e0!3m2!1sth!2sth!4v1727777451458!5m2!1sth!2sth"
					width="250"
					height="200"
					style="border:0;"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					class="mt-4"
				></iframe>
			</div>
		</div>
	</div>

	<!-- COPYRIGHT -->
	<div
		class="bg-th-foot-bg-2 p-4 text-center text-xs leading-[1.2rem] text-th-foot-text dark:bg-th-foot-bg-2-dark md:p-5 md:py-3"
	>
		<div class="mx-auto w-full max-w-th-width-lg px-4 md:px-5">
			© 2025
			<a
				href="https://crs.mahidol.ac.th"
				class="text-th-foot-text hover:text-white hover:opacity-80"
				>CRS, Mahidol University</a
			>.
			{footerText.copyright}
		</div>
	</div>
</footer>
