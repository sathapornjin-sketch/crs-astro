---
import { aboutSideTH } from '@/data/about/th/AboutSide';
import { aboutSideEN } from '@/data/about/en/AboutSide';

// ตรวจภาษาจาก URL จริง
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isEn = pathname.startsWith('/en/');

// เลือก data ตามภาษา
const items = isEn ? aboutSideEN : aboutSideTH;

// หา slug ปัจจุบัน
// /about/history        → history
// /en/about/history     → history
const seg = pathname.split('/');
const current = isEn ? seg[3] : seg[2];

// base link
const base = isEn ? '/en/about' : '/about';

// title
const title = isEn ? 'About CRS' : 'เกี่ยวกับวิทยาลัย';
---
<ul class="divide-y rounded-th-rounded-2 bg-th-bg-1 shadow-th-shadow-1">
  <li class="px-4 py-2.5">
    <h2 class="text-xl">{title}</h2>
  </li>

  {items
    .sort((a, b) => a.order - b.order)
    .map(i => (
      <li
        class={current === i.slug
          ? 'border-l-4 border-th-primary pl-3 font-bold'
          : 'px-4 py-2.5'}
      >
        <a href={`${base}/${i.slug}/`}>{i.title}</a>
      </li>
    ))}
</ul>
