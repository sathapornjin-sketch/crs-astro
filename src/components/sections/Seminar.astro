/* -------------------------
   SORT (ใหม่ → เก่า)
-------------------------- */
const months = {
  "มกราคม":"01","กุมภาพันธ์":"02","มีนาคม":"03","เมษายน":"04",
  "พฤษภาคม":"05","มิถุนายน":"06","กรกฎาคม":"07","สิงหาคม":"08",
  "กันยายน":"09","ตุลาคม":"10","พฤศจิกายน":"11","ธันวาคม":"12"
};

function parseDate(d){
  const [day,month,year] = d.split(" ");
  return new Date(`${year - 543}-${months[month]}-${day}`);
}

seminar.sort((a,b)=> parseDate(b.date) - parseDate(a.date));

/* -------------------------
   PAGINATION
-------------------------- */
let seminarPerPage = 3;
let seminarPage = 1;

/* -------------------------
   RENDER LIST
-------------------------- */
function renderSeminar(page) {
  const container = document.getElementById("seminar-container");
  if (!container) return;

  const start = (page - 1) * seminarPerPage;

  container.innerHTML = seminar.slice(start, start + seminarPerPage)
    .map(item => `
      <a href="${item.link ? item.link : `/seminar/${item.slug}/`}" target="_blank"
         class="block overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-transform duration-300 hover:-translate-y-1">

        <div class="relative w-full h-56 bg-white overflow-hidden flex items-center justify-center">
          <img src="${item.image}" class="w-full h-full object-cover"/>
        </div>

        <div class="p-4">
          <p class="text-sm text-gray-500 mb-2">${item.date}</p>
          <h3 class="text-sm font-light leading-snug text-black mb-2">${item.title}</h3>
          <span class="text-blue-700 font-medium hover:underline">อ่านเพิ่มเติม → <br>Read More</span>
        </div>

      </a>
    `)
    .join('');
}

/* -------------------------
   RENDER PAGINATION BUTTONS
-------------------------- */
function renderSeminarPagination() {
  const pagination = document.getElementById("seminar-pagination");
  if (!pagination) return;

  pagination.innerHTML = '';
  const totalPages = Math.ceil(seminar.length / seminarPerPage);

  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;

    btn.className =
      `px-4 py-2 rounded-lg ${i === seminarPage
        ? "bg-blue-700 text-white"
        : "bg-white text-blue-700 border hover:bg-blue-100"} transition`;

    btn.onclick = () => {
      seminarPage = i;
      renderSeminar(seminarPage);
      renderSeminarPagination();
    };

    pagination.appendChild(btn);
  }
}

/* -------------------------
   INIT (เหมือน congratulation 100%)
-------------------------- */
function initSeminar() {
  renderSeminar(seminarPage);
  renderSeminarPagination();
}

window.addEventListener("pageshow", initSeminar);
document.addEventListener("astro:page-load", initSeminar);
