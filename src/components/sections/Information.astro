    <!-- แถบ Pagination -->
    <div class="flex justify-center mt-10 space-x-2" id="information-pagination"></div>
  </div>
</section>

<script>  
const information = [
  
  {
    title: "ประกาศประกวดราคาเช่าเครื่องคอมพิวเตอร์ ด้วยวิธีประกวดราคาอิเล็กทรอนิกส์ (e-bidding)",
    src: "https://drive.google.com/file/d/1szHl9hy7vBTja9Bxi3OXAiDuR1M0LS-0/preview",
    link: "https://crs.mahidol.ac.th/news/",
    image: "img/news/crslogo.png"
  },
  {
    title: "เปิดรับสมัครแล้ว TCAS รอบ 1/2 – Portfolio วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล จำนวนรับ 64 ที่นั่ง (รวม 3 โครงการ)",
    type: "video", 
    src: "https://drive.google.com/file/d/1szHl9hy7vBTja9Bxi3OXAiDuR1M0LS-0/preview",
    link: "https://crs.mahidol.ac.th/education/tcas/"
  },
  {
    title: "ขอเชิญทุกท่านร่วมถวายทุนภัตตาหารเพลและทุนการศึกษาแด่พระนักศึกษาของวิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล",
    link: "https://www.facebook.com/CrsMahidol/posts/pfbid02fZdyd2G92LV5i35TXpctMjkDFjEvt5KEuLNmo38HBZzdFMN8szb41tUd1qhu2TDXl",
    image: "img/information/nov2025/infor_food25nov2025.jpg"
  },
  {
    title: "ขอเชิญทุกท่านร่วมทำบุญเดือนเกิด ในวันที่ 28 พฤศจิกายน 2568 ณ ลานประติมากรรมดอกกันภัย อาคารศูนย์การเรียนรู้ ม.มหิดล",
    link: "https://www.facebook.com/CrsMahidol/posts/pfbid0oQ4awYcXQGUUVU9bcnmuC7pJojGfYjy2eaZoYsy3AZTxLiPVk7JvQLMmwuQXzaS4l",
    image: "img/information/nov2025/infor_birth28nov2025.jpg"
  },
  {
    title: "ขอเชิญลงทะเบียนเข้าร่วมกิจกรรมทัศนศึกษาโครงการ “ตามรอยคัมภีร์ กรุงศรีอยุธยา” ศึกษาเรียนรู้เรื่องประวัติศาสตร์กรุงศรีอยุธยาและคัมภีร์ใบลานทัศนศึกษา “ตามรอยคัมภีร์ กรุงศรีอยุธยา” ณ จังหวัดพระนครศรีอยุธยา วันเสาร์ที่ 20 ธันวาคม พ.ศ. 2568",
    link: "https://www.facebook.com/CrsMahidol/posts/pfbid0VpuwB1nc1vf9XJaFHKfpBb1h6tyWT7YVUKU81QfqFb1NQehF8YmeMV38mEeL1zkQl",
    image: "img/activities/nov2025/new_Ayutthaya.jpg"
  },
  {
    title: "วิทยาลัยศาสนศึกษา มหาวิทยาลัยมหิดล ประกาศ เปิดรับสมัครงาน ตำแหน่ง นักวิชาการศึกษา จำนวน 1 อัตรา",
    link: "https://www.facebook.com/CrsMahidol/posts/pfbid02BfaQCi5A4rQJV7VgjqdruqgXT9gMSo7uCDMWRPwdJfgSeckC8XcLvbv4sPSphqhMl",
    image: "img/information/nov2025/hiring_education.jpg"
  },
  {
    title: "การบรรยายในหัวข้อ Empress Wu Zetian and Her Faith in the Maitreya Bodhisattva ในวันพุธที่ 19 พฤศจิกายน 2568 เวลา 14.00 น.",
    link: "https://www.facebook.com/CrsMahidol/posts/pfbid02RFxk4Mfavty9D4rAmXB9uengMF46gMkWf7dkohTNfsNHK4FZJp5FTnFdcNuaQmUfl",
    image: "img/information/nov2025/EmpressWuZetian.jpg"
  },  
];

let itemsPerPage = 3;
let currentPage = 1;

function renderInformation(page) {
  const start = (page - 1) * itemsPerPage;
  const container = document.getElementById("information-container");

  container.innerHTML = information.slice(start, start + itemsPerPage).map(item => {

    if (item.type === "video" && item.src) {
      return `
        <div class="block overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-transform duration-300 hover:-translate-y-1">
          <div class="relative w-full h-56 bg-black overflow-hidden">
            <iframe
              src="${item.src}"
              class="w-full h-full"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          </div>

          <div class="p-4">
            <h3 class="text-lg md:text-m font-semibold text-blue-800 leading-snug mb-2">
              ${item.title}
            </h3>
            ${item.link ? `<a href="${item.link}" target="_blank" class="text-blue-700 font-medium hover:underline">อ่านเพิ่มเติม →</a>` : ""}
          </div>
        </div>
      `;
    }

    // ข่าวแบบภาพ
    return `
      <a href="${item.link}" target="_blank"
         class="block overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-transform duration-300 hover:-translate-y-1">
        <div class="relative w-full h-56 flex items-center justify-center bg-white overflow-hidden">
          <img src="${item.image || ''}" class="max-w-full max-h-full object-contain"/>
        </div>

        <div class="p-4">
          <h4 class="text-lg md:text-m font-semibold text-blue-800 leading-snug mb-2">${item.title}</h4>
          <span class="text-blue-700 font-medium hover:underline">อ่านเพิ่มเติม →</span>
        </div>
      </a>
    `;
  }).join('');
}

function renderPagination() {
  const totalPages = Math.ceil(information.length / itemsPerPage);
  const pagination = document.getElementById("information-pagination");
  pagination.innerHTML = '';

  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;
    btn.className = `px-4 py-2 rounded-lg ${i === currentPage ? 'bg-blue-700 text-white' : 'bg-white text-blue-700 border hover:bg-blue-100'} transition`;
    btn.onclick = () => { currentPage = i; renderInformation(currentPage); renderPagination(); };
    pagination.appendChild(btn);
  }
}

document.addEventListener("DOMContentLoaded", () => {
  renderInformation(currentPage);
  renderPagination();
});
</script>