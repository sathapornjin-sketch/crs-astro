/* -------------------------
   Sort by date (ใหม่ → เก่า)
-------------------------- */
const months = {
  "มกราคม":"01","กุมภาพันธ์":"02","มีนาคม":"03","เมษายน":"04","พฤษภาคม":"05",
  "มิถุนายน":"06","กรกฎาคม":"07","สิงหาคม":"08","กันยายน":"09","ตุลาคม":"10",
  "พฤศจิกายน":"11","ธันวาคม":"12"
};

function parseDate(d){
  const parts = d.split(" ");
  return new Date(`${parts[2] - 543}-${months[parts[1]]}-${parts[0]}`);
}

congratulations.sort((a,b)=> parseDate(b.date) - parseDate(a.date));

/* -------------------------
   Pagination
-------------------------- */
let congratsPerPage = 3;
let congratsPage = 1;

/* -------------------------
   Render list
-------------------------- */
function renderCongrats(page) {
  const start = (page - 1) * congratsPerPage;
  const container = document.getElementById("congrats-container");
  if (!container) return;

  container.innerHTML = congratulations.slice(start, start + congratsPerPage)
    .map(item => `
      <a href="${item.link}" target="_blank"
         class="block overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-transform duration-300 hover:-translate-y-1">

        <div class="relative w-full h-56 flex items-center justify-center bg-white overflow-hidden">
          <img src="${item.image}" class="w-full h-full object-cover" />
        </div>

        <div class="p-4">
          <p class="text-sm text-gray-500 mb-2">${item.date}</p>
          <h4 class="text-lg font-semibold text-black leading-snug mb-2">${item.title}</h4>
          <span class="text-blue-700 font-medium hover:underline">อ่านเพิ่มเติม →</span>
        </div>

      </a>
    `).join('');
}

/* -------------------------
   Render pagination buttons
-------------------------- */
function renderCongratsPagination() {
  const totalPages = Math.ceil(congratulations.length / congratsPerPage);
  const pagination = document.getElementById("congrats-pagination");
  if (!pagination) return;

  pagination.innerHTML = '';

  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;

    btn.className =
      `px-4 py-2 rounded-lg ${i === congratsPage
        ? 'bg-blue-700 text-white'
        : 'bg-white text-blue-700 border hover:bg-blue-100'} transition`;

    btn.onclick = () => {
      congratsPage = i;
      renderCongrats(congratsPage);
      renderCongratsPagination();
    };

    pagination.appendChild(btn);
  }
}

/* -------------------------
   Init (เหมือน activities 100%)
-------------------------- */
function initCongratsSection() {
  renderCongrats(congratsPage);
  renderCongratsPagination();
}

/* โหลดเมื่อ back-forward */
window.addEventListener("pageshow", () => {
  initCongratsSection();
});

/* โหลดเมื่อเปลี่ยนหน้าแบบ client-side */
document.addEventListener("astro:page-load", () => {
  initCongratsSection();
});
</script>
