/* -------------------------
   Sort by date (ใหม่ → เก่า)
-------------------------- */
const months = {
  "มกราคม":"01","กุมภาพันธ์":"02","มีนาคม":"03","เมษายน":"04","พฤษภาคม":"05",
  "มิถุนายน":"06","กรกฎาคม":"07","สิงหาคม":"08","กันยายน":"09","ตุลาคม":"10",
  "พฤศจิกายน":"11","ธันวาคม":"12"
};

function parseDate(d){
  const [day, month, year] = d.split(" ");
  return new Date(`${year - 543}-${months[month]}-${day}`);
}

activities.sort((a,b)=> parseDate(b.date) - parseDate(a.date));

/* -------------------------
   Pagination
-------------------------- */
let itemsPerPage = 3;
let currentPage = 1;

/* -------------------------
   Render list
-------------------------- */
function renderActivities(page) {
  const start = (page - 1) * itemsPerPage;
  const container = document.getElementById("activities-container");
  if (!container) return;

  container.innerHTML = activities
    .slice(start, start + itemsPerPage)
    .map(act => {

      const href = (act.isBirth || act.isCollab)
        ? act.link
        : `/activities/${act.slug}/`;

      return `
        <a href="${href}" target="_blank"
           class="block overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-transform duration-300 hover:-translate-y-1">
          <div class="relative w-full h-56 flex items-center justify-center bg-white overflow-hidden">
            <img src="${act.image}" class="w-full h-full object-cover" />
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-500 mb-2">${act.date}</p>
            <h4 class="text-sm font-light text-black leading-snug mb-2">${act.title}</h4>
            <span class="text-blue-700 font-medium hover:underline">อ่านเพิ่มเติม →</span>
          </div>
        </a>
      `;
    })
    .join('');
}

/* -------------------------
   Render pagination buttons
-------------------------- */
function renderPagination() {
  const totalPages = Math.ceil(activities.length / itemsPerPage);
  const pagination = document.getElementById("activities-pagination");
  if (!pagination) return;

  pagination.innerHTML = '';

  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;
    btn.className = `px-4 py-2 rounded-lg ${i === currentPage ? 'bg-blue-700 text-white' : 'bg-white text-blue-700 border hover:bg-blue-100'} transition`;
    btn.onclick = () => { 
      currentPage = i; 
      renderActivities(currentPage); 
      renderPagination();
    };
    pagination.appendChild(btn);
  }
}

/* -------------------------
   Init (เหมือน Information)
-------------------------- */
function initActivitiesSection() {
  renderActivities(currentPage);
  renderPagination();
}

/* โหลดทุกครั้งที่กลับมาหน้านี้ */
window.addEventListener("pageshow", () => {
  initActivitiesSection();
});

/* โหลดทุกครั้งที่ Astro เปลี่ยนหน้าแบบ client-side */
document.addEventListener("astro:page-load", () => {
  initActivitiesSection();
});
